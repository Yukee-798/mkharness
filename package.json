{
  "name": "agent-generative-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm test:unit && pnpm test:workers && pnpm build",
    "deploy": "pnpm build && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "build:test": "CLOUDFLARE_ENV=test vite build",
    "deploy:test": "pnpm build:test && wrangler deploy --env test",
    "db:migrate:test": "wrangler d1 migrations apply DB --remote --env test",
    "models": "node scripts/models.mjs"
  },
  "dependencies": {
    "@ag-ui/client": "0.0.59",
    "@ag-ui/core": "0.0.59",
    "@assistant-ui/react": "0.15.26",
    "@assistant-ui/react-ag-ui": "0.0.66",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-durable": "1.1.0",
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "@openuidev/lang-core": "0.3.2",
    "@openuidev/react-headless": "0.17.0",
    "@openuidev/react-lang": "0.3.2",
    "@openuidev/react-ui": "0.17.0",
    "@radix-ui/react-slot": "1.2.4",
    "@tailwindcss/vite": "4.3.3",
    "agents": "0.28.0",
    "assistant-stream": "0.3.49",
    "better-auth": "1.7.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "hono": "4.13.13",
    "quickjs-emscripten-core": "0.32.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "rxjs": "7.8.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "zod": "4.6.5",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.63.1",
    "@cloudflare/vitest-plugin": "1.4.0",
    "@cloudflare/workers-types": "5.20261006.1",
    "@playwright/test": "1.58.2",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "26.1.0",
    "typescript": "7.0.2",
    "vite": "8.0.0",
    "vitest": "4.1.0",
    "wrangler": "4.149.0"
  },
  "imports": {
    "#quickjs.wasm": "@jitl/quickjs-wasmfile-release-sync/wasm"
  }
}
