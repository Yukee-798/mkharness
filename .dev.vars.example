# Copy to .dev.vars. This file contains no credentials.
AUTH_MODE=guest
ALLOW_SERVER_MODEL_KEY=0
# pnpm setup fills only missing secrets in .dev.vars; retain these across restarts/deploys.
CREDENTIAL_ENCRYPTION_KEY=
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MODEL_PROVIDER=deepseek
MODEL_ID=deepseek-flash
# Optional deployment default; requires ALLOW_SERVER_MODEL_KEY=1.
# Free demo: MODEL_PROVIDER=openrouter, MODEL_ID=openrouter/free, MODEL_THINKING_LEVEL=off.
# Store your OpenRouter key as MODEL_API_KEY (never commit it). No paid fallback.
MODEL_API_KEY=
# Optional
# Comma-separated model allowlist for this provider; omitted = only the configured model.
# Must include MODEL_ID. Example for deepseek: deepseek-flash,deepseek-v4-pro
MODEL_IDS=
MODEL_THINKING_LEVEL=low
# Optional web search: omitted or blank = search_web is not available to the Agent.
# read_web remains available without an API key.
TAVILY_API_KEY=

# Enable/disable reviewed extensions in extensions.config.ts.
# These bindings configure limits, connections and secrets only.
TOOL_CALL_LIMIT=40
# JSON configuration, credentials referenced by env variable name only.
MCP_SERVERS=[]
# REFERENCE_MCP_TOKEN=
# Concrete async example: disabled until URL is configured.
ASYNC_SERVICE_URL=
ASYNC_SERVICE_TOKEN=
# none: never automatically repeat an uncertain submit; key/lookup require verified provider semantics.
ASYNC_RECOVERY=none
