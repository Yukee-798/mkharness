{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Fresh native Pi installation. Do not point these bindings at an older deployment.
  "name": "mkharness-native",
  "main": "src/server.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "run_worker_first": ["/api/*", "/"],
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
  },
  "vars": {
    "APP_URL": "http://localhost:5173",
    "ALLOW_SERVER_MODEL_KEY": "0",
    "MODEL_PROVIDER": "",
    "MODEL_ID": "",
  },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": ["**/*.wasm"],
      "fallthrough": true,
    },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "MCP_CONNECTIONS", "class_name": "McpConnection" },
      {
        "name": "CONVERSATIONS",
        "class_name": "ChatSession",
      },
    ],
  },
  "exports": {
    "ChatSession": { "type": "durable-object", "storage": "sqlite" },
    "McpConnection": { "type": "durable-object", "storage": "sqlite" },
  },
  "r2_buckets": [{ "binding": "SKILL_FILES", "bucket_name": "mkharness-native-skills-local" }],
  "d1_databases": [
    {
      "binding": "DB",
      // Omit database_id for new-resource provisioning; never copy an existing ID.
      "database_name": "mkharness-native-local",
      "migrations_dir": "migrations",
    },
  ],
  "env": {
    "production": {
      "name": "mkharness-native",
      "vars": {
        "APP_URL": "https://template.mkharness.com",
        // Public template demo only; other deployments use personal keys.
        "ALLOW_SERVER_MODEL_KEY": "1",
        "MODEL_PROVIDER": "openrouter",
        "MODEL_ID": "openrouter/free",
        "MODEL_THINKING_LEVEL": "off",
      },
      "routes": [{ "pattern": "template.mkharness.com", "custom_domain": true }],
      "durable_objects": {
        "bindings": [
          { "name": "CONVERSATIONS", "class_name": "ChatSession" },
          { "name": "MCP_CONNECTIONS", "class_name": "McpConnection" },
        ],
      },
      "r2_buckets": [{ "binding": "SKILL_FILES", "bucket_name": "mkharness-native-skills" }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "mkharness-native",
          "database_id": "a063ea46-7733-492c-bd22-c95ff4493b6c",
          "migrations_dir": "migrations",
        },
      ],
      "workers_dev": false,
      "preview_urls": false,
    },
    "test": {
      "name": "mkharness-native-test",
      "vars": {
        // Replace with the new test deployment's exact origin before deployment.
        "APP_URL": "https://mkharness-native-test.yukee798.workers.dev",
        "ALLOW_SERVER_MODEL_KEY": "0",
        "MODEL_PROVIDER": "",
        "MODEL_ID": "",
      },
      "durable_objects": {
        "bindings": [
          { "name": "MCP_CONNECTIONS", "class_name": "McpConnection" },
          {
            "name": "CONVERSATIONS",
            "class_name": "ChatSession",
          },
        ],
      },
      "r2_buckets": [{ "binding": "SKILL_FILES", "bucket_name": "mkharness-native-test-skills" }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "mkharness-native-test",
          "database_id": "945a18c1-1b56-4883-91a5-9fddab5e79a6",
          "migrations_dir": "migrations",
        },
      ],
      "workers_dev": true,
      "preview_urls": false,
    },
  },
}
