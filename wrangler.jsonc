{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Existing Worker identity: keep it to preserve local/remote DO storage.
  // For a fresh MkHarness installation, set name to "mkharness" before provisioning.
  "name": "agent-generative-ui",
  "main": "src/server.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "run_worker_first": ["/api/*", "/"],
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
  },
  "vars": {
    "APP_URL": "http://localhost:5173",
    "AUTH_MODE": "guest",
    "ALLOW_SERVER_MODEL_KEY": "0",
    "MODEL_PROVIDER": "",
    "MODEL_ID": "",
  },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": ["**/*.wasm"],
      "fallthrough": true,
    },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "MCP_CONNECTIONS", "class_name": "McpConnection" },
      {
        "name": "CONVERSATIONS",
        "class_name": "ConversationAgent",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ConversationAgent"],
    },
    { "tag": "v2-mcp-connections", "new_sqlite_classes": ["McpConnection"] },
  ],
  "r2_buckets": [{ "binding": "SKILL_FILES", "bucket_name": "agent-generative-ui-skills-local" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agent-generative-ui-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "env": {
    "production": {
      "name": "mkharness-template",
      "vars": {
        "APP_URL": "https://template.mkharness.com",
        "AUTH_MODE": "account",
        "ALLOW_SERVER_MODEL_KEY": "1",
        "MODEL_PROVIDER": "openrouter",
        "MODEL_ID": "openrouter/free",
        "MODEL_THINKING_LEVEL": "off",
      },
      "routes": [{ "pattern": "template.mkharness.com", "custom_domain": true }],
      "durable_objects": {
        "bindings": [
          { "name": "CONVERSATIONS", "class_name": "ConversationAgent" },
          { "name": "MCP_CONNECTIONS", "class_name": "McpConnection" },
        ],
      },
      "r2_buckets": [{ "binding": "SKILL_FILES", "bucket_name": "mkharness-template-skills" }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "mkharness-template",
          "database_id": "02817316-ab35-48b2-891f-66aba0351752",
          "migrations_dir": "migrations",
        },
      ],
      "workers_dev": false,
      "preview_urls": false,
    },
    "test": {
      "name": "agent-generative-ui-test-20261010-7591",
      "vars": {
        "APP_URL": "https://agent-generative-ui-test-20261010-7591.yukee798.workers.dev",
        "AUTH_MODE": "guest",
        "ALLOW_SERVER_MODEL_KEY": "0",
        "MODEL_PROVIDER": "",
        "MODEL_ID": "",
      },
      "durable_objects": {
        "bindings": [
          { "name": "MCP_CONNECTIONS", "class_name": "McpConnection" },
          {
            "name": "CONVERSATIONS",
            "class_name": "ConversationAgent",
          },
        ],
      },
      "r2_buckets": [
        { "binding": "SKILL_FILES", "bucket_name": "agent-generative-ui-test-skills" },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "agent-generative-ui-test-20261010-7591",
          "database_id": "5c257aeb-5d9d-4260-b7e4-381054e00500",
          "migrations_dir": "migrations",
        },
      ],
      "workers_dev": true,
      "preview_urls": false,
    },
  },
}
