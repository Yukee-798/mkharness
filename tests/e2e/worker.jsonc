{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "mkharness-native-e2e",
  "main": "../../src/server.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "APP_URL": "http://localhost:5174",
    "ALLOW_SERVER_MODEL_KEY": "0",
    "MODEL_PROVIDER": "",
    "MODEL_ID": "",
    "BETTER_AUTH_SECRET": "local-test-only-secret-at-least-32-chars",
    "GOOGLE_CLIENT_ID": "fixture",
    "GOOGLE_CLIENT_SECRET": "fixture",
    "CREDENTIAL_ENCRYPTION_KEY": "bW1tbW1tbW1tbW1tbW1tbW1tbW1tbW1tbW1tbW1tbW0=",
  },
  "durable_objects": {
    "bindings": [
      { "name": "CONVERSATIONS", "class_name": "ChatSession" },
      { "name": "MCP_CONNECTIONS", "class_name": "McpConnection" },
    ],
  },
  "exports": {
    "ChatSession": { "type": "durable-object", "storage": "sqlite" },
    "McpConnection": { "type": "durable-object", "storage": "sqlite" },
  },
  "r2_buckets": [
    { "binding": "SKILL_FILES", "bucket_name": "mkharness-native-e2e-skills" },
    { "binding": "ARTIFACT_FILES", "bucket_name": "mkharness-native-e2e-artifacts" },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mkharness-native-e2e",
      "migrations_dir": "../../migrations",
    },
  ],
  "rules": [{ "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": true }],
}
