{
  "name": "pi-hmr-probe",
  "main": "./worker.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "CONVERSATIONS", "class_name": "ChatSession" }],
  },
  "exports": { "ChatSession": { "type": "durable-object", "storage": "sqlite" } },
  "vars": { "MODEL_PROVIDER": "fixture", "MODEL_ID": "fixture" },
}
